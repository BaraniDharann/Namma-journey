        {
          "name": "Driver Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suresh Sharma\",\n  \"mobile\": \"9123456789\",\n  \"password\": \"YOUR_DRIVER_PASSWORD\",\n  \"licenseNumber\": \"DL1420110012345\",\n  \"aadhaarNumber\": \"123456789012\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/driver/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "driver", "signup"]
            }
          }
        },
        {
          "name": "Driver Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9123456789\",\n  \"password\": \"YOUR_DRIVER_PASSWORD\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/driver/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "driver", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Owner Authentication",
      "item": [
        {
          "name": "Owner Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"YOUR_OWNER_PASSWORD\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/owner/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "owner", "login"]
            }
          }
        }
      ]
    }
  ]
}
