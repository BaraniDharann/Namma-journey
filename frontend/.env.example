# Copy this to .env and fill in your values
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=Namma Journey
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
VITE_OWNER_UPI_ID=your_upi_id@bank
VITE_OWNER_UPI_NAME=Your Business Name
VITE_OTP_TEST_MODE=true
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Third-party map services. The defaults (baked into src/config/mapServices.js) are free
# community demo instances that are rate limited and not licensed for production traffic —
# set these to self-hosted or commercial endpoints before deploying.
VITE_OSRM_BASE_URL=https://router.project-osrm.org
VITE_PHOTON_BASE_URL=https://photon.komoot.io
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
