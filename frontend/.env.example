# Copy this to .env and fill in your values.
#
# IMPORTANT: everything prefixed VITE_ is substituted into the JavaScript bundle at build time
# and served to every visitor. These are public values. Never put a secret, an API key with any
# privilege, or a payment address here — read the built file in dist/assets/ and you will find
# whatever you set. Secrets belong in the backend .env at the repository root, which is read by
# the server and never shipped to a browser.

# Where the API lives. Leave it unset to call the same origin the app is served from, which is
# what the Docker Compose setup does — nginx proxies /api and /ws through to the backend.
VITE_API_BASE_URL=http://localhost:8080/api

# Google sign-in. The client ID is public by design; the client *secret* is a backend setting.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Third-party map services. The defaults (baked into src/config/mapServices.js) are free
# community demo instances that are rate limited and not licensed for production traffic —
# set these to self-hosted or commercial endpoints before deploying.
VITE_OSRM_BASE_URL=https://router.project-osrm.org
VITE_PHOTON_BASE_URL=https://photon.komoot.io
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Removed from this file on purpose:
#
#   VITE_OWNER_UPI_ID / VITE_OWNER_UPI_NAME
#     Nothing in the frontend reads these, and they must not come back. The UPI intent and its
#     QR code are built server-side by PaymentService and arrive in the payment response, so the
#     payee address never needs to exist in browser code. Setting it here would have published
#     the account that collects every fare, in a file anyone can read.
#
#   VITE_OTP_TEST_MODE
#     Unused, and it read as though a client-side flag could weaken OTP checks. It cannot —
#     OTP_TEST_MODE is a backend setting, and it must stay false outside the E2E suite.
#
#   VITE_APP_NAME / VITE_APP_VERSION / VITE_APP_ENV
#     Unused.
