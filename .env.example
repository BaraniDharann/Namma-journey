# Database Configuration
DB_URL=jdbc:postgresql://localhost:5433/postgres
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP Email Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_NAME=Namma Journey

# OTP Configuration
OTP_EXPIRY_MINUTES=5

# Payment Configuration
OWNER_UPI_ID=your-upi-id@yourbank
OWNER_UPI_NAME=Namma Journey

# Telegram Driver Dispatch (optional; leave TELEGRAM_ENABLED=false to disable entirely)
# See TELEGRAM_SETUP.md for how to obtain these.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=YourBotName_bot
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_string

# Server Configuration
SERVER_PORT=8080

# CORS — comma-separated list of origins allowed to call the API.
# Must include wherever the frontend is served from, or every browser request is blocked.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Caching. "redis" uses the Redis settings below; "caffeine" caches in-process and needs no
# Redis at all — use that for a single-instance or local setup.
APP_CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty when Redis has no password set.
REDIS_PASSWORD=

# Rate limiting — requests per minute, per client IP.
RATELIMIT_AUTH=10
RATELIMIT_AUTHENTICATED=200
RATELIMIT_GENERAL=60
# Comma-separated IPs/CIDRs whose X-Forwarded-For header is believed. Leave EMPTY when the
# app is reachable directly: trusting forwarded headers from any peer lets a caller spoof
# their IP and bypass rate limiting entirely. Set this to your proxy/load balancer only.
RATELIMIT_TRUSTED_PROXIES=

# One-time bootstrap for the very first owner account, via POST /api/auth/owner/create-admin.
# That endpoint returns an owner token — full control of the platform — so it stays DISABLED
# while this is empty. Set it, create your owner, then clear it again.
OWNER_BOOTSTRAP_SECRET=

# File uploads (driver documents, trip photos)
FILE_UPLOAD_DIR=uploads

# Routing and geocoding. The defaults are public demo servers — fine for development, but
# rate-limited and not suitable for production. Self-host or use a paid provider for real traffic.
OSRM_BASE_URL=http://router.project-osrm.org
PHOTON_BASE_URL=https://photon.komoot.io

# Telegram API endpoint — only override this to point at a mock server in tests.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Schema is owned by Flyway; "validate" makes the app refuse to boot if the entities and the
# database disagree. Do not change this to "update" — it lets Hibernate silently alter tables.
JPA_DDL_AUTO=validate

# Health checks. Disable a probe if that dependency is intentionally absent.
MANAGEMENT_HEALTH_REDIS_ENABLED=true
MANAGEMENT_HEALTH_MAIL_ENABLED=true

# Test-only. When true, OTPs are written to the database instead of being emailed, so the E2E
# suite can read them back. NEVER enable this in production — it makes every account takeable.
OTP_TEST_MODE=false

# --- Docker Compose only ---------------------------------------------------
# docker-compose.yml passes these straight to the postgres image to create the
# database on first boot. They are separate from DB_URL/DB_USERNAME/DB_PASSWORD
# above, which are what the application uses to connect — the two must agree, and
# in compose the host is the service name, e.g.
#   DB_URL=jdbc:postgresql://postgres:5432/travel_booking_db
POSTGRES_DB=travel_booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
