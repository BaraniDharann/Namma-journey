# Database Configuration
# Host setup. Under Docker Compose the host is the service name instead:
#   DB_URL=jdbc:postgresql://postgres:5432/travel_booking_db
DB_URL=jdbc:postgresql://localhost:5432/travel_booking_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP Email Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_NAME=Namma Journey

# OTP Configuration
OTP_EXPIRY_MINUTES=5

# Payment Configuration
# REQUIRED. This is the account that collects every customer payment, so it deliberately has
# no default — the application refuses to start without it rather than fall back to whatever
# UPI ID happened to be in the source.
OWNER_UPI_ID=your-upi-id@yourbank
OWNER_UPI_NAME=Namma Journey

# Razorpay online payments (optional). Dashboard -> Account & Settings -> API keys.
# Use rzp_test_ keys until KYC is done, then swap in rzp_live_ keys - no code change.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_key_secret
# Generate with: openssl rand -hex 32. Enter the same value in Dashboard -> Webhooks, with URL
# https://<your-domain>/api/payments/razorpay/webhook and events payment.captured, order.paid,
# payment.failed, refund.processed, refund.failed.
RAZORPAY_WEBHOOK_SECRET=replace_with_a_long_random_string

# Telegram Driver Dispatch (optional; leave TELEGRAM_ENABLED=false to disable entirely)
# See TELEGRAM_SETUP.md for how to obtain these.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=YourBotName_bot
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_string

# Passenger ride safety over the same bot (ride updates, live map, "are you safe?" checks, SOS).
# See TELEGRAM_SETUP.md -> "Passenger ride safety".
# Telegram group that receives SOS alerts (add the bot to the group; group ids are negative).
SAFETY_OPS_CHAT_ID=
# Base of the public share-trip link: <PUBLIC_BASE_URL>/trip/<token>
PUBLIC_BASE_URL=https://nammajourneys.site

# Server Configuration
SERVER_PORT=8080

# CORS — comma-separated list of origins allowed to call the API.
# Must include wherever the frontend is served from, or every browser request is blocked.
# http://localhost covers the Docker Compose setup, where nginx serves the SPA on port 80;
# :5173 and :4173 are the Vite dev and preview servers.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:4173

# Caching. "redis" uses the Redis settings below; "caffeine" caches in-process and needs no
# Redis at all — use that for a single-instance or local setup.
APP_CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Required by docker-compose (Redis starts with --requirepass). Generate a long random value,
# e.g. `openssl rand -hex 32`. Leave empty only for a local, passwordless Redis outside Docker.
REDIS_PASSWORD=

# Rate limiting — requests per minute, per client IP.
RATELIMIT_AUTH=10
RATELIMIT_AUTHENTICATED=200
RATELIMIT_GENERAL=60
# Payment and QR-generation endpoints, per account. Each call renders a QR code, so this is
# deliberately far below RATELIMIT_AUTHENTICATED.
RATELIMIT_PAYMENT=15
# Comma-separated IPs/CIDRs whose X-Forwarded-For header is believed. Leave EMPTY when the
# app is reachable directly: trusting forwarded headers from any peer lets a caller spoof
# their IP and bypass rate limiting entirely. Set this to your proxy/load balancer only.
# docker-compose defaults it to the Docker bridge ranges (nginx is the proxy there); leave it
# empty here unless you run behind a different proxy.
RATELIMIT_TRUSTED_PROXIES=

# One-time bootstrap for the very first owner account, via POST /api/auth/owner/create-admin.
# That endpoint returns an owner token — full control of the platform — so it stays DISABLED
# while this is empty. Set it, create your owner, then clear it again.
OWNER_BOOTSTRAP_SECRET=

# The single owner account. There is exactly one, and the E2E suite signs in as it rather than
# creating its own — it used to mint a throwaway owner per run, leaving a stray ROLE_OWNER row
# behind each time. Spring does not read these; only playwright-tests/helpers/env.ts does.
OWNER_EMAIL=
OWNER_PASSWORD=

# File uploads (driver documents, trip photos)
FILE_UPLOAD_DIR=uploads

# Routing and geocoding. The defaults are public demo servers — fine for development, but
# rate-limited and not suitable for production. Self-host or use a paid provider for real traffic.
OSRM_BASE_URL=http://router.project-osrm.org
PHOTON_BASE_URL=https://photon.komoot.io

# Telegram API endpoint — only override this to point at a mock server in tests.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Schema is owned by Flyway; "validate" makes the app refuse to boot if the entities and the
# database disagree. Do not change this to "update" — it lets Hibernate silently alter tables.
JPA_DDL_AUTO=validate

# Health checks. Disable a probe if that dependency is intentionally absent.
MANAGEMENT_HEALTH_REDIS_ENABLED=true

# Upload storage. "local" = this server's disk (one instance only). "s3" = shared object storage,
# required before running more than one backend. Cloudflare R2 example:
#   STORAGE_TYPE=s3  S3_BUCKET=namma-uploads  S3_REGION=auto
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY=...  S3_SECRET_KEY=...
# For AWS S3 leave S3_ENDPOINT empty and set S3_REGION (e.g. ap-south-1). Copy existing files
# into the bucket under the same paths before switching (aws s3 sync uploads s3://<bucket>/uploads).
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Monitoring (docker-compose prometheus + grafana services)
# Token Prometheus presents to read /actuator/prometheus. Empty = metrics endpoint refuses
# everyone. Generate with `openssl rand -hex 32`.
METRICS_SCRAPE_TOKEN=
# Grafana "admin" password (http://localhost:3000, loopback only).
GRAFANA_ADMIN_PASSWORD=
MANAGEMENT_HEALTH_MAIL_ENABLED=true

# Test-only. When true, OTPs are written to the database instead of being emailed, so the E2E
# suite can read them back. NEVER enable this in production — it makes every account takeable.
OTP_TEST_MODE=false

# --- Docker Compose only ---------------------------------------------------
# docker-compose.yml passes these straight to the postgres image to create the
# database on first boot. They are separate from DB_URL/DB_USERNAME/DB_PASSWORD
# above, which are what the application uses to connect — the two must agree, and
# in compose the host is the service name, e.g.
#   DB_URL=jdbc:postgresql://postgres:5432/travel_booking_db
POSTGRES_DB=travel_booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Background jobs: notification emails and Razorpay refunds go through an outbox table and are
# retried until delivered. in-process needs nothing else; sqs shares the work across instances
# through an AWS SQS queue (see DEPLOYMENT_CHECKLIST.md for the queue + dead-letter setup).
OUTBOX_TRANSPORT=in-process
# OUTBOX_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/namma-jobs
# OUTBOX_SQS_REGION=ap-south-1
# OUTBOX_SQS_ACCESS_KEY=
# OUTBOX_SQS_SECRET_KEY=

# REQUIRED for driver payouts: encrypts payout UPI IDs at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32. Keep it safe - without it saved UPI IDs cannot be read.
APP_ENCRYPTION_KEY=
# Trip advance (share of the fare paid online to hold a Trip; 0 disables), hold and refund window.
TRIP_ADVANCE_PERCENT=20
TRIP_ADVANCE_HOLD_MINUTES=30
TRIP_ADVANCE_REFUND_HOURS=24

# Images the server pulls (built by CI, .github/workflows/main.yml). IMAGE_TAG is normally left
# unset - scripts/deploy.sh sets it per deploy (latest, or a commit sha to deploy/roll back).
# IMAGE_PREFIX=ghcr.io/baranidharann/namma-journey
# Backend JVM memory. Default -Xms256m -Xmx512m suits a 2 GB server; raise -Xmx on a bigger one.
# BACKEND_JAVA_OPTS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:+ExitOnOutOfMemoryError

# Running several backend servers (docker-compose.prod.yml). WebSocket pushes then go through
# RabbitMQ's STOMP plugin instead of each server's in-memory broker.
WEBSOCKET_BROKER=simple
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_USERNAME=namma
# RABBITMQ_PASSWORD=change_me
# BACKEND_REPLICAS=2
# Prepared OSRM map data for self-hosted routing; see docs/guides/OSRM_SETUP.md
# OSRM_DATA_DIR=./osrm-data
