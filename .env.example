# Database Configuration
DB_URL=jdbc:postgresql://localhost:5433/postgres
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP Email Configuration
MAIL_USERNAME=nammajourney463@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_NAME=Namma Journey

# OTP Configuration
OTP_EXPIRY_MINUTES=5

# Payment Configuration
OWNER_UPI_ID=your-upi-id@yourbank
OWNER_UPI_NAME=Namma Journey

# Telegram Driver Dispatch (optional; leave TELEGRAM_ENABLED=false to disable entirely)
# See TELEGRAM_SETUP.md for how to obtain these.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_USERNAME=YourBotName_bot
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_string

# Server Configuration
SERVER_PORT=8080
